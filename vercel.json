{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "finchmortgages.co.nz"
        }
      ],
      "destination": "https://www.finchmortgages.co.nz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "finchmortgages.co.nz"
        }
      ],
      "destination": "https://www.finchmortgages.co.nz/:path*",
      "permanent": true
    },
    {
      "source": "/weekly-reports/week-11-first-home-grant",
      "destination": "/blog/first-home-grant-nz-closed-alternatives",
      "permanent": true
    },
    {
      "source": "/weekly-reports/week-1-year-ahead-2026",
      "destination": "/blog/will-mortgage-rates-drop-nz-2026",
      "permanent": true
    },
    {
      "source": "/weekly-reports/week-2-mortgage-stress-testing",
      "destination": "/blog/mortgage-stress-test-rate-nz",
      "permanent": true
    },
    {
