{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "finchmortgages.co.nz" }],
      "destination": "https://www.finchmortgages.co.nz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "finchmortgages.co.nz" }],
      "destination": "https://www.finchmortgages.co.nz/:path*",
      "permanent": true
    },
    {
      "source": "/testimonials.html",
      "destination": "/testimonials/reviews.html",
      "permanent": true
    },
    {
      "source": "/refinance.html",
      "destination": "/calculators/refinance-savings.html",
      "permanent": true
    },
    {
      "source": "/lenders/kiwibank-home-loan-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/asb-mortgage-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/westpac-mortgage-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/tsb-mortgage-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/hsbc-nz-mortgage-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/icbc-nz-mortgage-review.html",
      "destination": "/lenders/major-banks.html",
      "permanent": true
    },
    {
      "source": "/lenders/resimac-mortgage-review.html",
      "destination": "/lenders/non-bank-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/bluestone-mortgage-review.html",
      "destination": "/lenders/non-bank-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/asap-finance-mortgage-review.html",
      "destination": "/lenders/specialist-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/finance-now-asset-review.html",
      "destination": "/lenders/specialist-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/marac-asset-finance-review.html",
      "destination": "/lenders/specialist-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/mitsubishi-hc-capital-review.html",
      "destination": "/lenders/specialist-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/udc-finance-asset-review.html",
      "destination": "/lenders/specialist-lenders.html",
      "permanent": true
    },
    {
      "source": "/lenders/first-credit-union-mortgage-review.html",
      "destination": "/lenders/credit-unions.html",
      "permanent": true
    },
    {
      "source": "/lenders/police-credit-union-mortgage-review.html",
      "destination": "/lenders/credit-unions.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/logos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/finch.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
