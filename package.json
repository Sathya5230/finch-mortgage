{
  "name": "finch-mortgage",
  "version": "1.0.0",
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "script.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx tailwindcss@3 -c tailwind.config.js -i tailwind.src.css -o tailwind.css --minify",
    "build:style": "npx clean-css-cli -o style.css style.src.css",
    "build:js": "npx terser script.src.js -c -m -o script.js",
    "build": "npm run build:css && npm run build:style && npm run build:js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
